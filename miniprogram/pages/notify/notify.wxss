.page {
  padding: 24rpx;
}
.notify-card {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.text {
  font-size: 28rpx;
  color: var(--text-main);
}
.time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-disabled);
}
.clear {
  margin-top: 24rpx;
  background: #fff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  border-radius: var(--radius-sm);
}
