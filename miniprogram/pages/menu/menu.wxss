.page {
  background: var(--bg-page);
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}
.header {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--surface);
  border-bottom: 1rpx solid var(--border-color);
}
.store-name {
  font-size: 34rpx;
  font-weight: 600;
}
.header-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.header-line {
  display: flex;
  align-items: center;
}
.entry-tag {
  margin-left: var(--space-2);
  font-size: 22rpx;
  color: var(--brand-primary);
  border: 1rpx solid var(--brand-primary);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
}
.store-phone {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.header-side {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.store-hours {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.nav-btn {
  margin-top: 8rpx;
  background: var(--surface);
  color: var(--brand-primary);
  border: 1rpx solid var(--brand-primary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  line-height: 1.6;
}
.nav-btn-hover {
  background: var(--brand-soft);
}
.banner {
  height: 240rpx;
  margin: var(--space-2) var(--space-4) 0;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
}
.banner-slide {
  height: 100%;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 var(--space-4);
}
.slide-1 {
  background: linear-gradient(135deg, #f0643a, #f5b391);
}
.slide-2 {
  background: linear-gradient(135deg, #e0834a, #f0c39a);
}
.slide-3 {
  background: linear-gradient(135deg, #c75b36, #e9a383);
}
.banner-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}
.banner-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
}
.search-box {
  padding: var(--space-3) var(--space-4);
  background: var(--surface);
  border-bottom: 1rpx solid var(--border-color);
}
.search-input {
  background: var(--bg-page);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-secondary);
}
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.cats {
  width: 180rpx;
  background: var(--bg-page);
  height: 100%;
  border-right: 2rpx solid var(--border-color);
  box-shadow: 2rpx 0 6rpx rgba(38, 34, 30, 0.04);
}
.cat {
  padding: var(--space-3) var(--space-2);
  font-size: 26rpx;
  color: var(--text-secondary);
  border-left: 4rpx solid transparent;
}
.cat.active {
  background: var(--brand-soft);
  color: var(--brand-primary);
  border-left-color: var(--brand-primary);
  font-weight: 600;
}
.items {
  flex: 1;
  padding: var(--space-3);
  height: 100%;
}
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
}
.cart-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--space-3) var(--space-4) 40rpx;
  max-height: 60vh;
}
.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--border-color);
}
.cart-info {
  display: flex;
  flex-direction: column;
}
.cart-name {
  font-size: 28rpx;
}
.cart-price {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.checkout-btn {
  margin-top: var(--space-3);
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius-sm);
}
.checkout-btn-hover {
  background: var(--brand-strong);
}
