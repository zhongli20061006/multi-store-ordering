<view class="page">
  <icon type="success" size="72" />
  <view class="title">下单成功</view>
  <view class="desc">商家接单后可在「我的订单」查看</view>
  <view class="card">
    <view class="row">
      <text class="label">订单号</text>
      <text class="value">{{orderNo}}</text>
    </view>
    <view class="row">
      <text class="label">门店</text>
      <text class="value">{{storeName}}</text>
    </view>
    <view class="row">
      <text class="label">应付金额</text>
      <price cents="{{totalCents}}" />
    </view>
  </view>
  <store-info wx:if="{{store}}" store="{{store}}" />
  <button class="primary" bindtap="viewOrder">查看订单</button>
  <button class="ghost" bindtap="goHome">返回首页</button>
</view>
