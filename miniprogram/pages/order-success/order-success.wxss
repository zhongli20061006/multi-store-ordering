.page {
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx var(--space-4);
}
.title {
  margin-top: var(--space-3);
  font-size: 38rpx;
  font-weight: 600;
}
.desc {
  margin-top: var(--space-2);
  color: var(--text-secondary);
  font-size: 26rpx;
}
.card {
  width: 100%;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
  margin-top: 48rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}
.label {
  color: var(--text-secondary);
}
.value {
  color: var(--text-main);
}
.primary {
  width: 100%;
  margin-top: 48rpx;
  background: var(--brand-primary);
  color: #fff;
  border-radius: 999rpx;
}
.ghost {
  width: 100%;
  margin-top: var(--space-3);
  background: var(--surface);
  color: var(--text-main);
  border: 1rpx solid var(--border-color);
  border-radius: 999rpx;
}
