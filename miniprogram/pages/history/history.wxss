.page {
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4) var(--space-5);
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--space-2);
}
.top-title {
  font-size: 34rpx;
  font-weight: 700;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.action {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.action.primary {
  color: var(--brand-primary);
  font-weight: 600;
}
.action.danger {
  color: var(--danger);
}
.search-box {
  padding-bottom: var(--space-2);
}
.search-input {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.cats {
  white-space: nowrap;
  margin-bottom: var(--space-2);
}
.cat {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: var(--space-2);
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: 999rpx;
}
.cat.active {
  background: var(--brand-soft);
  color: var(--brand-primary);
  border-color: var(--brand-soft);
  font-weight: 600;
}
.row {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.check {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--text-disabled);
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.check.checked {
  border-color: var(--brand-primary);
  background: var(--brand-primary);
  box-shadow: inset 0 0 0 6rpx #fff;
}
.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.no {
  font-size: 30rpx;
  font-weight: 600;
}
.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.row-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.status {
  font-size: 26rpx;
  color: var(--text-main);
}
.total {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--brand-primary);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}
