.page {
  padding: 16rpx 24rpx;
}
.search-box {
  padding-bottom: 16rpx;
}
.search-input {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-secondary);
}
.store-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.store-main {
  display: flex;
  flex-direction: column;
}
.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.store-address {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.store-hours {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}
.store-status {
  font-size: 24rpx;
  color: #67c23a;
}
