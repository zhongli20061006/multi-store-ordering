.page {
  padding: var(--space-3) var(--space-4) var(--space-5);
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--space-2);
}
.top-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: var(--text-main);
}
.bell {
  position: relative;
  padding: 8rpx;
}
.bell-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
}
.bell-body {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 24rpx;
  height: 22rpx;
  border: 3rpx solid var(--text-main);
  border-top-left-radius: 14rpx;
  border-top-right-radius: 14rpx;
  border-bottom-left-radius: 5rpx;
  border-bottom-right-radius: 5rpx;
  box-sizing: border-box;
}
.bell-clapper {
  position: absolute;
  left: 14rpx;
  bottom: 2rpx;
  width: 12rpx;
  height: 8rpx;
  border-left: 3rpx solid var(--text-main);
  border-right: 3rpx solid var(--text-main);
  border-bottom: 3rpx solid var(--text-main);
  border-radius: 0 0 8rpx 8rpx;
  box-sizing: border-box;
}
.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}
.search-box {
  padding-bottom: var(--space-3);
}
.search-input {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-secondary);
}
.store-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}
.store-main {
  display: flex;
  flex-direction: column;
}
.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}
.store-address {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.store-phone {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.store-hours {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}
.store-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.cover-wrap {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin-bottom: var(--space-2);
}
.cover {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}
.cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-soft);
  color: var(--brand-primary);
  font-size: 44rpx;
  font-weight: 600;
}
.store-status {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 20rpx;
}
.nav-btn {
  margin-top: 12rpx;
  background: var(--surface);
  color: var(--brand-primary);
  border: 1rpx solid var(--brand-primary);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  line-height: 1.6;
}
.nav-btn-hover {
  background: var(--brand-soft);
}
