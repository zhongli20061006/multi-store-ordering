.page {
  padding: 16rpx 24rpx;
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}
.top-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}
.bell {
  position: relative;
  padding: 8rpx;
}
.bell-icon {
  font-size: 40rpx;
}
.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #f56c6c;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}
.search-box {
  padding-bottom: 16rpx;
}
.search-input {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}
.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-secondary);
}
.store-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.store-main {
  display: flex;
  flex-direction: column;
}
.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.store-address {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.store-hours {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}
.store-status {
  font-size: 24rpx;
  color: #67c23a;
}
