<view class="page">
  <view class="top-bar">
    <text class="top-title">多门店点单</text>
    <view class="bell" bindtap="goNotify">
      <view class="bell-icon">
        <view class="bell-body"></view>
        <view class="bell-clapper"></view>
      </view>
      <view wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    </view>
  </view>
  <view class="search-box">
    <input class="search-input" placeholder="搜索门店" value="{{keyword}}" bindinput="onSearchInput" />
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <empty-state
    wx:elif="{{error}}"
    title="加载失败"
    desc="请确认后端服务已启动后重试"
    action-text="重试"
    bind:action="retry"
  />
  <empty-state
    wx:elif="{{stores.length === 0}}"
    title="暂无营业中门店"
    desc="所有门店当前均已打烊"
  />
  <view wx:else class="store-list">
    <view
      class="store-card"
      wx:for="{{stores}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="goMenu"
    >
      <view class="store-main">
        <text class="store-name">{{item.name}}</text>
        <text class="store-address">{{item.address}}</text>
        <text class="store-phone">{{item.phone}}</text>
        <text wx:if="{{item.open_time}}" class="store-hours">营业时间 {{item.open_time}} - {{item.close_time}}</text>
      </view>
      <view class="store-side">
        <text class="store-status">营业中</text>
        <button class="nav-btn" size="mini" hover-class="nav-btn-hover" catchtap="onNavigate" data-item="{{item}}">导航</button>
      </view>
    </view>
  </view>
</view>
