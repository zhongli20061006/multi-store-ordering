.page {
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
}
.filter-tab {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.filter-tab.active {
  color: var(--brand-primary);
  border-color: var(--brand-primary);
  font-weight: 600;
}
.finder {
  margin-top: 32rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 24rpx;
}
.finder-header {
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
}
.finder-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}
.input {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.search {
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius-sm);
}
