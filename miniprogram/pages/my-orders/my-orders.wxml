<view class="page">
  <view class="filter-bar">
    <view
      class="filter-tab {{filterGroup === item.group ? 'active' : ''}}"
      wx:for="{{filterTabs}}"
      wx:key="group"
      data-group="{{item.group}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </view>
  <block wx:if="{{orders.length}}">
    <order-card
      wx:for="{{orders}}"
      wx:key="order_no"
      order="{{item}}"
      bind:detail="onDetail"
      bind:cancel="onCancel"
      bind:pickup="onPickup"
    />
  </block>
  <empty-state
    wx:else
    title="还没有订单"
    desc="下单成功后订单会直接显示在这里"
  />

  <view class="finder">
    <view class="finder-header" bindtap="toggleFinder">
      找回历史订单（手机号 + 订单号）
    </view>
    <view wx:if="{{showFinder}}" class="finder-body">
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="手机号"
        data-field="phone"
        value="{{phone}}"
        bindinput="onInput"
      />
      <input
        class="input"
        placeholder="订单号"
        data-field="orderNo"
        value="{{orderNo}}"
        bindinput="onInput"
      />
      <button class="search" size="mini" loading="{{querying}}" bindtap="onSearch">查询</button>
    </view>
  </view>
</view>
