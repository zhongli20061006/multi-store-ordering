<wxs module="fmt">
module.exports = { specs: function (s) { if (!s) return ''; return Object.keys(s).map(function (k) { return s[k] }).join(' · ') } }
</wxs>
<view class="page">
  <block wx:if="{{order}}">
    <view class="card">
      <view class="head">
        <text class="no">{{order.order_no}}</text>
        <status-badge status="{{order.order_status}}" type="order" />
      </view>
      <view class="meta">
        <text class="store">{{order.storeName}}</text>
        <status-badge status="{{order.entry_type}}" type="entry" />
      </view>
      <view class="meta">
        <text class="time">{{order.displayTime}}</text>
        <text class="pay">{{order.payment_status === 'paid' ? '已付款' : '未付款'}}</text>
      </view>
    </view>

    <store-info wx:if="{{store}}" store="{{store}}" />

    <view class="card">
      <view class="item" wx:for="{{order.items}}" wx:key="id">
        <view class="item-main">
          <text class="item-name">{{item.item_name}} × {{item.quantity}}</text>
          <text wx:if="{{item.specs}}" class="item-specs">{{fmt.specs(item.specs)}}</text>
        </view>
        <price cents="{{item.subtotal_cents}}" />
      </view>
      <view class="total">
        <text>共 {{order.item_count}} 件</text>
        <price cents="{{order.total_cents}}" />
      </view>
      <view wx:if="{{order.remark}}" class="remark">备注：{{order.remark}}</view>
    </view>

    <button wx:if="{{order.order_status === 'pending'}}" class="cancel" bindtap="onCancel">取消订单</button>
    <button wx:if="{{order.order_status === 'served'}}" class="pickup" bindtap="onPickup">已取单</button>
    <button class="reorder" bindtap="onReorder">再来一单</button>
  </block>
  <empty-state wx:else title="订单不存在" desc="请确认订单号与手机号" />
</view>
