.page {
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}
.card {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.no {
  font-size: 32rpx;
  font-weight: 600;
}
.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.store {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.time {
  font-size: 24rpx;
  color: var(--text-disabled);
}
.pay {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 28rpx;
}
.item-name {
  color: var(--text-main);
}
.item-main {
  display: flex;
  flex-direction: column;
}
.item-specs {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  font-weight: 600;
}
.remark {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.cancel {
  margin-top: 16rpx;
  background: #fff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  border-radius: var(--radius-sm);
}
.pickup {
  margin-top: 16rpx;
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius-sm);
}
.reorder {
  margin-top: 20rpx;
  background: var(--surface);
  color: var(--brand-primary);
  border: 1rpx solid var(--brand-primary);
  border-radius: var(--radius-sm);
}
