<wxs module="fmt">
module.exports = { yuan: function (cents) { return (cents / 100).toFixed(2) } }
</wxs>
<view class="page">
  <view class="card">
    <view class="card-title">{{storeName}} · {{entryType === 'dinein' ? '到店点单' : '提前点单'}}</view>
    <view class="line" wx:for="{{items}}" wx:key="menu_item_id">
      <view class="line-main">
        <text class="line-name">{{item.name}}</text>
        <quantity-stepper item="{{item}}" bind:change="onChangeQuantity" />
      </view>
      <view class="line-side">
        <price cents="{{item.unit_price_cents * item.quantity}}" />
        <button class="remove" size="mini" catchtap="onRemoveItem" data-id="{{item.menu_item_id}}" data-name="{{item.name}}">删除</button>
      </view>
    </view>
    <view class="line total">
      <text>共 {{totalCount}} 件</text>
      <price cents="{{totalCents}}" />
    </view>
  </view>

  <view class="card">
    <view class="form-row">
      <text class="label">联系人</text>
      <input
        class="input"
        placeholder="姓名"
        data-field="customerName"
        value="{{customerName}}"
        bindinput="onInput"
      />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="用于查单与联系"
        data-field="customerPhone"
        value="{{customerPhone}}"
        bindinput="onInput"
      />
    </view>
    <view class="form-row">
      <text class="label">备注</text>
      <input
        class="input"
        placeholder="口味/备注（选填）"
        data-field="remark"
        value="{{remark}}"
        bindinput="onInput"
      />
    </view>
  </view>

  <button
    class="submit"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >提交订单</button>
</view>
