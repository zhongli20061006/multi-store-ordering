.page {
  padding: 24rpx;
}
.card {
  background: var(--surface);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.line-name {
  color: var(--text-main);
}
.line.total {
  border-top: 1rpx solid var(--border-color);
  margin-top: 8rpx;
  padding-top: 20rpx;
  font-weight: 600;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.form-row:last-child {
  border-bottom: none;
}
.label {
  width: 140rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.submit {
  margin-top: 16rpx;
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius-sm);
}
.submit[disabled] {
  background: #c0c4cc;
  color: #fff;
}
