.page {
  background: var(--bg-page);
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4) var(--space-5);
}
.header {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  color: #fff;
  font-size: 52rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-info {
  margin-left: var(--space-3);
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: var(--space-2);
}
.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.label {
  width: 160rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.save {
  margin-top: var(--space-3);
  background: var(--brand-primary);
  color: #fff;
  border-radius: 999rpx;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 30rpx;
}
.cell:last-child {
  border-bottom: none;
}
.arrow {
  color: var(--text-disabled);
  font-size: 34rpx;
}
