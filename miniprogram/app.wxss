page {
  --brand-primary: #FF6B35;
  --text-main: #303133;
  --text-secondary: #909399;
  --text-disabled: #C0C4CC;
  --bg-page: #F5F7FA;
  --surface: #FFFFFF;
  --border-color: #E4E7ED;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  background: var(--bg-page);
  color: var(--text-main);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
