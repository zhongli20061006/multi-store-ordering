.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
}
.warning { background: #fbf0e2; color: var(--warning); }
.primary { background: var(--brand-soft); color: var(--brand-primary); }
.success { background: #eaf4ee; color: var(--success); }
.info { background: var(--surface-muted); color: var(--info); }
