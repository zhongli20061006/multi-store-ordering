.cart-bar {
  position: fixed;
  /* 左侧避开菜单页分类栏（180rpx），右侧留边距：不进入侧边栏、不贴边 */
  left: 196rpx;
  right: 24rpx;
  bottom: var(--space-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  color: var(--text-main);
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(38, 34, 30, 0.12);
}
.summary {
  display: flex;
  align-items: center;
}
.cart-icon {
  position: relative;
  width: 48rpx;
  height: 44rpx;
  margin-right: var(--space-2);
}
.cart-handle {
  position: absolute;
  top: 0;
  left: 12rpx;
  width: 22rpx;
  height: 14rpx;
  border: 3rpx solid var(--brand-primary);
  border-bottom: none;
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
  box-sizing: border-box;
}
.cart-body {
  position: absolute;
  top: 12rpx;
  left: 4rpx;
  width: 40rpx;
  height: 24rpx;
  border: 3rpx solid var(--brand-primary);
  border-top: none;
  border-bottom-left-radius: 6rpx;
  border-bottom-right-radius: 6rpx;
  box-sizing: border-box;
}
.cart-wheel {
  position: absolute;
  bottom: 0;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid var(--brand-primary);
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--surface);
}
.cart-wheel.left {
  left: 10rpx;
}
.cart-wheel.right {
  right: 10rpx;
}
.cart-label {
  display: flex;
  flex-direction: column;
}
.cart-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-primary);
}
.cart-meta {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.tabular {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}
.checkout {
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 28rpx;
}
.checkout-hover {
  background: var(--brand-strong);
}
.checkout[disabled] {
  background: var(--surface-muted);
  color: var(--text-disabled);
}
