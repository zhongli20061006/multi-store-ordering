.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: var(--text-secondary);
}
.title {
  margin-top: var(--space-3);
  font-size: 30rpx;
  color: var(--text-main);
}
.desc {
  margin-top: var(--space-2);
  font-size: 26rpx;
}
.action {
  margin-top: var(--space-4);
  background: var(--brand-primary);
  color: #fff;
  border-radius: 999rpx;
}
