# ============================================================
# 多门店点单系统 · 后端环境变量示例
# 使用方法：复制本文件为 .env 后按需修改
#   PowerShell: Copy-Item .env.example .env
# 注意：.env 包含密钥，已被 .gitignore 排除，禁止提交到 Git。
# ============================================================

# 应用名称（显示在 FastAPI 文档标题等处）
APP_NAME=多门店点单后端

# 数据库连接串。本地开发默认 SQLite（首次启动由 Alembic 自动建表迁移）。
# 上线切换 PostgreSQL 时改这里即可（SQLAlchemy 方言隔离）：
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ordering
DATABASE_URL=sqlite:///./data/ordering.db

# 上传目录（商品图/门店封面/轮播图），相对 backend/ 或绝对路径
UPLOAD_DIR=uploads

# JWT 签名密钥：**必须修改**为足够长的随机字符串（本地开发也建议换掉），
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=please-override-with-a-long-random-string-0123456789abcdef

# JWT 签名算法（保持 HS256 即可）
JWT_ALGORITHM=HS256

# JWT 过期时间（分钟），默认 1 天
JWT_EXPIRE_MINUTES=1440

# 种子管理员账号名（预留；当前种子固定创建 admin1/admin2，密码同为 SEED_ADMIN_PASSWORD）
SEED_ADMIN_USERNAME=admin

# 种子管理员初始密码：**仅用于本地演示**。
# 使用默认值种出的账号会标记 must_change_password=true，
# 首次登录后台强制要求修改密码后才可进入。
SEED_ADMIN_PASSWORD=admin123456

# CORS 允许来源，逗号分隔；本地调试可留 *，部署前必须按域名收紧
CORS_ORIGINS=*
